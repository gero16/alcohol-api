generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id            String                @id @default(cuid())
  slug          String                @unique
  position      Int
  title         String
  summary       String
  abv           String
  origin        String
  imageUrl      String
  imageAlt      String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  guide         Guide?
  glossaryLinks GlossaryItemCategory[]
  products      Product[]
}

model Guide {
  id         String    @id @default(cuid())
  categoryId String    @unique
  title      String
  type       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tabs       GuideTab[]
}

model GuideTab {
  id           String         @id @default(cuid())
  guideId      String
  slug         String
  label        String
  panelTitle   String?
  noteTitle    String?
  noteContent  String?
  position     Int
  /// Vocabulario compartido (intro, origin, drinks, …) para cruzar vino, destilados y licores.
  semanticKey  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  guide             Guide                  @relation(fields: [guideId], references: [id], onDelete: Cascade)
  sections          GuideSection[]
  tables            GuideTable[]
  classifications   GuideClassification[]

  @@unique([guideId, slug])
  @@index([guideId, position])
}

/// Marco o clasificación: secuencia ordenada de subtítulos, párrafos e imágenes (JSON).
model GuideClassification {
  id          String   @id @default(cuid())
  tabId       String
  slug        String
  blocks      Json     @default("[]")
  position    Int
  semanticKey String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tab         GuideTab @relation(fields: [tabId], references: [id], onDelete: Cascade)

  @@unique([tabId, slug])
  @@index([tabId, position])
}

model GuideSection {
  id          String           @id @default(cuid())
  tabId       String
  slug        String
  title       String
  subtitle    String
  imageUrl    String
  imageAlt    String
  position    Int
  semanticKey String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tab         GuideTab         @relation(fields: [tabId], references: [id], onDelete: Cascade)
  paragraphs  GuideParagraph[]

  @@unique([tabId, slug])
  @@index([tabId, position])
}

model GuideParagraph {
  id        String       @id @default(cuid())
  sectionId String
  content   String
  position  Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  section   GuideSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, position])
}

model GuideTable {
  id           String         @id @default(cuid())
  tabId        String
  slug         String
  title        String
  columns      Json
  position     Int
  /// Si se informa, en fichas de destilado con varias secciones la tabla se muestra en la pestaña de esa sección (slug de GuideSection en la misma pestaña).
  sectionSlug  String?
  semanticKey  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  tab          GuideTab       @relation(fields: [tabId], references: [id], onDelete: Cascade)
  rows         GuideTableRow[]

  @@unique([tabId, slug])
  @@index([tabId, position])
}

model GuideTableRow {
  id          String      @id @default(cuid())
  tableId      String
  term         String
  composition  String?
  objective    String?
  description  String?
  notes        String?
  reference    String?
  abv          String?
  ageingMaturation String?
  distillationMethod String?
  profileCharacter String?
  body         String?
  intensity    String?
  bitternessIbu String?
  finish       String?
  regionOrigin String?
  visualColor  String?
  tannins      String?
  acidity      String?
  examples     String?
  imageUrl     String?
  imageAlt     String?
  position     Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  table        GuideTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId, position])
}

// ─── Enums para productos ──────────────────────────────────────────────────────

enum WhiskyType {
  SINGLE_MALT
  SINGLE_GRAIN
  BLENDED_MALT
  BLENDED_SCOTCH
  BOURBON
  TENNESSEE_WHISKEY
  RYE
  IRISH
  JAPANESE
  WORLD
}

enum WineType {
  TINTO
  BLANCO
  ROSADO
  ESPUMOSO
  DULCE
  SEMI_DULCE
  SEMI_SECO
  FORTIFICADO
}

enum WineStyle {
  JOVEN
  ROBLE
  CRIANZA
  RESERVA
  GRAN_RESERVA
}

/// Cuerpo/densidad del líquido en boca, aplicable a cualquier bebida.
enum BodyDensity {
  LOW
  MEDIUM_LOW
  MEDIUM
  MEDIUM_HIGH
  HIGH
}

/// Escala simple para taninos (tintos) y acidez (blancos), etc.
enum WineSensoryLevel {
  LOW
  MEDIUM
  HIGH
}

// ─── Catálogo de productos / marcas específicas ────────────────────────────────

model Product {
  id                String      @id @default(cuid())
  slug              String      @unique
  name              String
  brand             String
  categorySlug      String
  subcategorySlug   String?
  abv               Float?
  origin            String?
  regionDetail      String?
  imageUrl          String?
  imageAlt          String?
  shortDescription  String?
  longDescription   String?
  /// "On the rocks", "En copa técnica", "Highball", etc.
  servingSuggestion String?
  priceRange        String?
  featured          Boolean     @default(false)
  /// Tags libres para búsqueda: ["ahumado", "mezcla", "picante"]
  tags              Json?
  /// Cuerpo/densidad en boca (LOW → HIGH)
  bodyDensity       BodyDensity?
  /// Proporción de mezcla recomendada: "70/30 Cola", "Ginger Ale 1:3"
  mixingRatio       String?

  // Notas de cata — arrays para permitir filtrado por sabor/aroma
  tastingColor      String?
  /// ["cítricos", "vainilla", "humo joven"]
  tastingNose       Json?
  /// ["especias", "malta", "pimienta"]
  tastingPalate     Json?
  tastingFinish     String?

  // Whisky
  whiskyType        WhiskyType?
  distillery        String?
  /// Años de guarda; "NAS" si no tiene declaración de edad
  ageStatement      String?
  caskType          String?
  /// Indica si el whisky es ahumado con turba (filtro clave para usuarios)
  isPeated          Boolean?

  // Vino
  wineType          WineType?
  wineStyle         WineStyle?
  vintage           Int?
  producer          String?
  /// Varietal declarado o tipo de blend (ej. "100% Malbec", "Cabernet · Merlot").
  varietal          String?
  /// Crianza en barrica (complementa `wineStyle` para Reserva / Gran Reserva, etc.).
  oakAging          Boolean?
  tanninLevel       WineSensoryLevel?
  acidityLevel      WineSensoryLevel?
  /// [{ "grape": "Malbec", "percentage": 70 }, ...]
  grapes            Json?

  // Cerveza
  beerStyle         String?
  ibu               Int?
  beerColor         String?

  // Maridajes: ["Carnes rojas", "Quesos azules", ...]
  pairings          Json?

  /// Apto para celíacos (sin gluten / elaboración sin trigo, cebada, etc., según etiquetado o criterio editorial).
  celiacFriendly    Boolean?
  /// Apto vegano (sin ingredientes de origen animal en la elaboración habitual).
  veganFriendly     Boolean?
  /// Elaboración orgánica / ecológica (ej. líneas certificadas).
  isOrganic         Boolean?
  /// Nota libre: aclaraciones dietarias, advertencias o fuente del dato.
  note              String?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  category          Category    @relation(fields: [categorySlug], references: [slug])

  @@index([categorySlug])
  @@index([subcategorySlug])
}

model GlossaryItem {
  id                String                @id @default(cuid())
  slug              String                @unique
  term              String
  shortDefinition   String
  featured          Boolean               @default(false)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  details           GlossaryDetail[]
  relatedCategories GlossaryItemCategory[]
}

model GlossaryDetail {
  id             String       @id @default(cuid())
  glossaryItemId String
  content        String
  position       Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  glossaryItem   GlossaryItem @relation(fields: [glossaryItemId], references: [id], onDelete: Cascade)

  @@index([glossaryItemId, position])
}

model GlossaryItemCategory {
  glossaryItemId String
  categoryId     String
  position       Int
  createdAt      DateTime     @default(now())
  glossaryItem   GlossaryItem @relation(fields: [glossaryItemId], references: [id], onDelete: Cascade)
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([glossaryItemId, categoryId])
  @@index([categoryId, position])
  @@index([glossaryItemId, position])
}
